# Copy to .env (chmod 600) and fill in. Never commit .env.

# ---- your broker (docs/BROKERS.md) ----
# trading212 (the default), alpaca, ibkr, or csv (an export from any broker). Read only:
# the desk never places an order at any broker.
# BROKER=trading212
# Alpaca: a key pair from its dashboard; paper for a paper account
# ALPACA_API_KEY=
# ALPACA_API_SECRET=
# ALPACA_ENV=live
# Interactive Brokers: a Flex Web Service token and an Activity Flex Query's number
# IBKR_FLEX_TOKEN=
# IBKR_FLEX_QUERY=
# Any other broker: its history exported as CSV (account.csv here, or a file or folder named below)
# BROKER_CSV=account.csv
# BROKER_CURRENCY=USD
# BROKER_NAME=
# BROKER_CSV_DATES=dmy

# Trading 212 → Settings → API (Beta) → Generate key.
# Tick Account data, Portfolio, History. Leave Orders UNticked (read-only).
T212_API_KEY=
T212_API_SECRET=
# live = your real account, demo = Trading 212 practice account
T212_ENV=live

# SEC EDGAR asks automated requests to declare a contact address (no key needed)
SEC_CONTACT=

# Free keys, no card: tiingo.com (daily prices), finnhub.io (earnings dates + estimates)
TIINGO_API_KEY=
FINNHUB_API_KEY=

# Optional: plain-English company summaries, the weekly news briefs and the Ask chat (your own OpenAI key, billed per use)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.6-luna

# Optional: bring in new code from GitHub each time the desk opens (a fast-forward of main,
# never over a file you edited). Off unless set to 1.
# AUTO_UPDATE=1

# Optional: open this desk from your phone through Tailscale, one desk for both
# (docs/ONE-DESK.md). The Mac's Tailscale name, like my-mac.tail1234.ts.net.
DESK_HOSTS=
